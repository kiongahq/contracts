{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kionga.dev/schemas/ingest/trace/v1.json",
  "title": "Kionga agent trace",
  "description": "Body of POST /api/v1/traces, one agent turn reported by the agent runtime or the SDK. Open contract (see docs/compatibility.md): the gateway accepts and ignores properties it does not know, so a newer producer never fails against an older gateway.",
  "x-kionga-policy": "open",
  "type": "object",
  "required": [
    "agent_id",
    "session_id"
  ],
  "additionalProperties": true,
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "End user of the turn; the SDK sends null when it has none."
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "current_node": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "description": "Free-form structured fields."
    }
  }
}
